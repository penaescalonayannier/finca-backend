	<parameter name="id_cirugia" class="java.lang.String"/>
	<parameter name="insuranse" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
  s.id AS id,
  TO_CHAR(s.scheduled_date, 'DD/MM/YYYY') AS fecha_cirugia,
  -- Paciente
  UPPER(p.firstname || ' ' || p.lastname) AS paciente_fullname,
  p.identification,
  DATE_PART('year', AGE(p.createdat))::int AS edad,
  p.gender,
  -- Doctor
  UPPER(d.name || ' ' || d.lastname)        AS doctor_fullname,
  d.registernumber,
  sp.name                                  AS doctor_specialty,
  -- Clínica
  b.name           AS clinica,
  b.logo, b.phone, b.email, b.website,

  -- Preoperatorio
  pre.admission_reason            AS motivo_ingreso ,
  pre.current_disease_history     AS historia_enfermedad_actual ,
  pre.physical_examination        AS examen_fisico ,

  -- Intraoperatorio
  io.date                         AS fecha_intra,
  io.start_time                   AS hora_inicio_intra,
  io.end_time                     AS hora_fin_intra,
  io.procedure_type               AS tipo_procedimiento,
  io.anesthesia_type              AS tipo_anestesia,
  io.projected_procedure          AS procedimiento_proyectado,
  io.performed_procedure          AS procedimiento_realizado,
  io.dieresis, io.exposition_exploration,
  io.surgical_findings, io.blood_loss,
  io.approximate_blood, io.prosthetic_material,
  io.surgical_procedure,
  io.description                  AS descripcion_intra,

  -- Postoperatorio
  post.treatment_summary         AS resumen_tratamiento,
  post.discharge_instructions    AS instrucciones_alta,
  post.life_status               AS estado_vida,
  post.discharge_condition       AS condicion_alta,
  post.stay_days                 AS dias_estadia,
  post.rest_days                 AS dias_reposo,
  post.clinical_summary          AS resumen_clinico,
  post.evolution_summary         AS resumen_evolucion,
  post.diagnostic_findings       AS hallazgos_diagnosticos,

  -- Anestesia
  a.anesthesia_type, a.mouth_opening, a.thyromental_distance,
  a.neck_circumference, a.mallampati,
  a.cervical_mobility, a.mandibular_protrusion,
  a.difficult_intubation_history,
  a.intubation_difficulties, a.thorax_description,
  a.heart_description, a.lungs_description,
  a.abdomen_description, a.extremities_description,
  a.central_nervous_system, a.asa_physical_status,
  a.operation_risks, a.metabolic_equivalent,
  a.last_intoxication_hours,
  a.anesthetics, a.surgical_drugs,
  a.allergies, a.transfusions, a.habits,

  -- Diagnósticos
  dp.icdcode AS cod_diag_presuntivo,
  dp.description AS desc_diag_presuntivo,
  dd.icdcode AS cod_diag_definitivo,
  dd.description AS desc_diag_definitivo,

  -- Signos Vitales (pre / intra / post)
  svp.recorded_at AS fecha_sv_pre,
  svp.systolic_blood_pressure || '/' || svp.diastolic_blood_pressure AS presion_pre,
  svp.oxygen_saturation AS saturacion_pre,
  svp.heart_rate AS fc_pre,
  svp.respiratory_rate AS fr_pre,
  svp.temperature,

  svi.recorded_at AS fecha_sv_intra,
  svi.systolic_blood_pressure || '/' || svi.diastolic_blood_pressure AS presion_intra,
  svi.oxygen_saturation AS saturacion_intra,
  svi.heart_rate AS fc_intra,
  svi.respiratory_rate AS fr_intra,
  svi.temperature,
  
  svpo.recorded_at AS fecha_sv_post,
  svpo.systolic_blood_pressure || '/' || svpo.diastolic_blood_pressure AS presion_post,
  svpo.oxygen_saturation AS saturacion_post,
  svpo.heart_rate AS fc_post,
  svpo.respiratory_rate AS fr_post,
  svpo.temperature,

  -- Evoluciones (pre / intra / post)
  ev_pre.evolution_date            AS fecha_evolucion_pre,
  ev_pre.therapeutic_fluids       AS fluidos_terapeuticos_pre,
  ev_pre.prescription_fluids      AS fluidos_prescripcion_pre ,

  ev_intra.evolution_date         AS fecha_evolucion_intra ,
  ev_intra.therapeutic_fluids     AS fluidos_terapeuticos_intra ,
  ev_intra.prescription_fluids    AS fluidos_prescripcion_intra ,

  ev_post.evolution_date          AS fecha_evolucion_post ,
  ev_post.therapeutic_fluids      AS fluidos_terapeuticos_post,
  ev_post.prescription_fluids     AS fluidos_prescripcion_post,

  -- Equipo de operación
  mt.member_name || ' ' || mt.member_last_name  AS equipo_nombre,
  mt.role                                     AS equipo_rol,

  -- Tratamientos pre / intra / post
  tr_pre.name       AS medicamento_pre,
  tr_pre.description AS observ_pre,
  tr_intra.name     AS medicamento_intra,
  tr_intra.description AS observ_intra,
  tr_post.name      AS medicamento_post,
  tr_post.description AS observ_post

FROM surgery.surgeries s
LEFT JOIN patient.patients p ON p.id = s.patient_id
LEFT JOIN surgery.doctors d ON d.id = s.doctor_id
LEFT JOIN surgery.specialties sp ON sp.id = s.specialty_id
LEFT JOIN identity.business b ON b.id = s.business_id

LEFT JOIN surgery.pre_operative pre ON pre.surgery_id = s.id
LEFT JOIN surgery.intra_operative io ON io.surgery_id = s.id
LEFT JOIN surgery.post_operative post ON post.surgery_id = s.id
LEFT JOIN surgery.anesthesia a ON a.surgery_id = s.id

LEFT JOIN surgery.diagnosis dp ON dp.surgery_id = s.id AND dp.type = 'PRESUNTIVO'
LEFT JOIN surgery.diagnosis dd ON dd.surgery_id = s.id AND dd.type = 'DEFINITIVO'

LEFT JOIN surgery.vital_signs svp ON svp.surgery_id = s.id AND svp.process = 'PRE_OPERATIVE'
LEFT JOIN surgery.vital_signs svi ON svi.surgery_id = s.id AND svi.process = 'INTRA_OPERATIVE'
LEFT JOIN surgery.vital_signs svpo ON svpo.surgery_id = s.id AND svpo.process = 'POST_OPERATIVE'

LEFT JOIN surgery.evolutions ev_pre ON ev_pre.surgery_id = s.id AND ev_pre.process = 'PRE_OPERATIVE'
LEFT JOIN surgery.evolutions ev_intra ON ev_intra.surgery_id = s.id AND ev_intra.process = 'INTRA_OPERATIVE'
LEFT JOIN surgery.evolutions ev_post ON ev_post.surgery_id = s.id AND ev_post.process = 'POST_OPERATIVE'

LEFT JOIN surgery.medical_teams mt ON mt.surgery_id = s.id

LEFT JOIN surgery.treatments tr_pre ON tr_pre.surgery_id = s.id AND tr_pre.process = 'PRE_OPERATIVE'
LEFT JOIN surgery.treatments tr_intra ON tr_intra.surgery_id = s.id AND tr_intra.process = 'INTRA_OPERATIVE'
LEFT JOIN surgery.treatments tr_post ON tr_post.surgery_id = s.id AND tr_post.process = 'POST_OPERATIVE'
WHERE s.id = $P{id_cirugia}::uuid]]></query>
