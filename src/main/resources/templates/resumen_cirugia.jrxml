<jasperReport name="resumen_cirugia" language="javascript" columnCount="1" printOrder="Horizontal" pageWidth="612" pageHeight="1500"  columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1ec03513-9f2c-44dc-8b19-110688072a63" floatColumnFooter="true">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="doctorkyn"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="230"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="761"/>
