<jasperReport name="informe_medic" language="javascript" printOrder="Horizontal" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c352693a-a449-4d92-8526-37a41f118d0f">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Treatment"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="239"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="756"/>
	<dataset name="Diagnostico" uuid="24755bd6-a2ef-4978-98f7-576ecc853f5a">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="272"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="720"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="doctorkyn"/>
		<parameter name="id_consulta" class="java.lang.String"/>
		<query language="SQL"><![CDATA[Select  (treatment.diagnosis.icdcode || ' - ' ||  treatment.diagnosis.description) as Diagnostico from  treatment.diagnosis where  treatment.diagnosis.external_consultation_id = $P{id_consulta}  ::uuid]]></query>
		<field name="diagnostico" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="diagnostico"/>
			<property name="com.jaspersoft.studio.field.label" value="diagnostico"/>
		</field>
		<group name="diagnostico">
			<expression><![CDATA[$F{diagnostico}]]></expression>
		</group>
	</dataset>
	<parameter name="id_consulta" class="java.lang.String"/>
	<parameter name="fecha_prox_cita" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    TO_CHAR(treatment.external_consultation.consultationtime, 'DD/MM/YYYY') AS consultationtime,
    treatment.external_consultation.id,
    patient.patients.firstname as name,
    patient.patients.lastname,
    UPPER(patient.patients.first_name || ' ' || patient.patients.lastname) as fullname,
    patient.patients.identification,
    DATE_PART('year', AGE(patient.patients.birthdaydate))::int AS edad,
    CASE
        WHEN patient.patients.gender = 'FEMALE' THEN 'FEMENINO'
        WHEN patient.patients.gender = 'MALE' THEN 'MASCULINO'
        ELSE ''
        END AS gender,
    treatment.doctor."name" as name_dr,
    treatment.doctor.lastname as apellido_dr,
    doctor.registernumber as regist_number,
    UPPER(treatment.doctor."name" || ' ' ||  COALESCE(treatment.doctor.lastname, '')) as fullname_dr,
    COALESCE(treatment.doctor.identification, '') as registernumber,
    treatment.medicines."name" as medicine,
    treatment.medicines."presentation" as presentation,
    treatment.treatment.description as description_tratment,
    treatment.treatment.medicineunit,
    treatment.treatment.quantity,
    treatment.external_consultation.referencenumber AS prescription_number,
    UPPER(identity.business.name) as clinica,
    COALESCE(treatment.services.name, ' ') as medicalspeciality,
    identity.business.logo,
	identity.business.email,
	identity.business.phone,
	identity.business.website
FROM treatment.external_consultation
         LEFT JOIN patient.patients  ON patient.patients.id = treatment.external_consultation.patient_id
         LEFT JOIN treatment.doctor ON treatment.doctor.id = treatment.external_consultation.doctor_id
         LEFT JOIN treatment.treatment ON treatment.treatment.external_consultation_id = treatment.external_consultation.id
         LEFT JOIN treatment.medicines ON treatment.medicines.id = treatment.treatment.medicines_id
         LEFT JOIN identity.business ON identity.business.id = treatment.external_consultation.business_id
         LEFT JOIN treatment.services ON treatment.services.id = treatment.external_consultation.service_id
           WHERE  treatment.external_consultation.id  = $P{id_consulta}::uuid]]></query>
