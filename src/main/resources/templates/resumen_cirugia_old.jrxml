		<parameter name="surgery_id" class="java.lang.String"/>
		<query language="SQL"><![CDATA[ Select 
 
 -- Tratamientos pre 
  tr_pre.name       AS medicamento_pre,
  tr_pre.description AS observ_pre

FROM surgery.treatments tr_pre 

INNER JOIN surgery.surgeries s ON s.id = tr_pre.surgery_id
WHERE tr_pre.process = 'Pre-Operatorio' AND  s.id =  $P{surgery_id} ::uuid]]></query>
