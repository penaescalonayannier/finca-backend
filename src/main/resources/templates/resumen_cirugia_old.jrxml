	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sistema Medido Kyn"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="245"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="750"/>
	<dataset name="Equipo Quirurgico" uuid="4c8e6841-d7ec-4bd1-aac9-497cf1e4ca7b">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sistema Medido Kyn"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="314"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="681"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="surgery_id" class="java.lang.String"/>
		<query language="sql"><![CDATA[Select   surgery.medical_teams.member_name,  surgery.medical_teams.member_last_name, 
UPPER(surgery.medical_teams.member_name || ' ' || surgery.medical_teams.member_last_name) AS member_fullname, surgery.medical_teams.specialty_name,
 surgery.doctors.identification,

CASE surgery.medical_teams.role
        WHEN 'surgeon1' THEN 'Cirujano 1'
        WHEN 'surgeon2' THEN 'Cirujano 2'
        WHEN 'firstAssistant' THEN 'Primer Ayudante'
        WHEN 'secondAssistant' THEN 'Segundo Ayudante'
        WHEN 'thirdAssistant' THEN 'Tercer Ayudante'
        WHEN 'scrubNurse' THEN 'Instrumentista'
        WHEN 'circulatingNurse' THEN 'Circulante'
        WHEN 'anesthesiologist' THEN 'Anestesiólogo/a'
        WHEN 'anesthesiaAssistant' THEN 'Ayudante de Anestesia'
        WHEN 'others' THEN 'Otros'
        ELSE 'Rol no especificado'
    END AS role
    from  surgery.medical_teams  
    left join  surgery.doctors ON  surgery.doctors.id = surgery.medical_teams.member_id 
    where  surgery.medical_teams.surgery_id  = $P{surgery_id}  ::uuid
    
        Order by surgery.medical_teams.created_at    



]]></query>
		<field name="member_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="member_name"/>
			<property name="com.jaspersoft.studio.field.label" value="member_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="medical_teams"/>
		</field>
