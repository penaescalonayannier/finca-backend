	<dataset name="Signos_Vit_Pre" uuid="7fefd3e8-6e7f-4ab0-ad7e-24fad5b36f72">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="362"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="633"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sistema Medido Kyn"/>
		<parameter name="surgery_id" class="java.lang.String"/>
		<query language="SQL"><![CDATA[Select

  -- Signos Vitales (pre / intra / post)
  svp.recorded_at AS fecha_sv_pre,
  svp.systolic_blood_pressure || '/' || svp.diastolic_blood_pressure AS presion_pre,
  svp.oxygen_saturation AS saturacion_pre,
  svp.heart_rate AS fc_pre,
  svp.respiratory_rate AS fr_pre,
  svp.temperature

  
From surgery.vital_signs svp
LEFT JOIN surgery.surgeries s  ON svp.surgery_id = s.id AND svp.process = 'Pre-Operatorio'

WHERE  s.id =  $P{surgery_id} ::uuid
]]></query>
