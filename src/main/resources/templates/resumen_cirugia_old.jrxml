		<parameter name="surgery_id" class="java.lang.String"/>
		<query language="sql"><![CDATA[Select

ev_intra.evolution_date         AS fecha_evolucion_intra ,
  ev_intra.therapeutic_fluids     AS fluidos_terapeuticos_intra ,
  ev_intra.prescription_fluids    AS fluidos_prescripcion_intra
  
  FROM surgery.evolutions ev_intra
  
LEFT JOIN surgery.surgeries s ON ev_intra.surgery_id = s.id AND ev_intra.process = 'Intra-Operatorio' 

where s.id =  $P{surgery_id}::uuid
  
  ]]></query>
		<field name="fecha_evolucion_intra" class="java.sql.Timestamp">
