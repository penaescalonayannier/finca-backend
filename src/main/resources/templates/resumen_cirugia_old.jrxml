	<dataset name="Evoluciones_pre" uuid="05e53f0c-fca3-400f-97f1-23f4b2c094c4">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sistema Medido Kyn"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="291"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="704"/>
		<parameter name="surgery_id" class="java.lang.String"/>
		<query language="sql"><![CDATA[Select
  ev_pre.evolution_date            AS fecha_evolucion_pre,
  ev_pre.therapeutic_fluids       AS fluidos_terapeuticos_pre,
  ev_pre.prescription_fluids      AS fluidos_prescripcion_pre 

  FROM surgery.evolutions ev_pre
  
LEFT JOIN surgery.surgeries s ON ev_pre.surgery_id = s.id AND ev_pre.process = 'Pre-Operatorio'

where s.id =  $P{surgery_id}::uuid
  
  ]]></query>
